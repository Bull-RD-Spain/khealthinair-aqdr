# AQDR - K-HEALTHinAIR | Dev containers configuration
# Copy this file to khealthinair-aqdr.env and adjust the values before running:
#   cp khealthinair-aqdr.env.example khealthinair-aqdr.env
#   podman compose --env-file ./khealthinair-aqdr.env up -d
# Never commit a filled-in env file. All values marked "REPLACE_ME" are secrets.

# --- Private image registry ---
REGISTRY_HOST=REPLACE_ME_REGISTRY_HOST:PORT

# --- General ---
APP_LOG_LEVEL=DEBUG
AQDR_API_CONTEXTPATH=/api
# JWT signing key (HS256). Generate one, e.g.: openssl rand -hex 32
AQDR_API_AUTH_SECRET_KEY=REPLAC…EY

# --- PostgreSQL (AQDR-Platform-DB) ---
POSTGRES_DB=sensors
POSTGRES_USER=khealthinair_admin
POSTGRES_PASSWORD=REPLAC…WORD
SENSORS_DB_NAME=sensors
SENSORS_DB_TABLE=sensors
SENSORS_DB_USER=sensors
SENSORS_DB_PASSWORD=REPLAC…WORD
SENSORS_DB_HOST=aqdr-platform-db
SENSORS_DB_PORT=8082

# --- Adminer ---
ADMINER_SERVER=aqdr-platform-db:8082
ADMINER_USERNAME=khealthinair_admin
ADMINER_DB=sensors
ADMINER_PASSWORD=REPLAC…WORD

# --- InfluxDB (AQDR-TS-DB) ---
INFLUXDB_URL=http://aqdr-ts-db:8086
DOCKER_INFLUXDB_INIT_USERNAME=khealthinair_admin
DOCKER_INFLUXDB_INIT_ORG=K-HEALTHinAIR
DOCKER_INFLUXDB_INIT_BUCKET=AIR_QUALITY
DOCKER_INFLUXDB_INIT_PASSWORD=REPLAC…WORD
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=REPLAC…KEN
INFLUX_EXTRA_BUCKETS=HEALTH_MONITORING
INFLUXDB_MEASUREMENT=CONTINUOUS_MONITORING_

# --- Grafana (AQDR-UI) ---
GRAFANA_INGRESS_URL=http://localhost:3000
GRAFANA_API_ENDPOINT=http://aqdr-ui:3000
GF_SECURITY_ADMIN_USER=khealthinair_admin
GF_SECURITY_ADMIN_PASSWORD=REPLAC…WORD
KHIA_DSOURCE_URL=http://aqdr-ts-db:8086
KHIA_DSOURCE_AUTH_USER=khealthinair_admin
KHIA_DSOURCE_AUTH_TOKEN=REPLAC…KEN
KHIA_DSOURCE_AUTH_PASSWORD=REPLAC…WORD

# --- Grafana SMTP ---
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.titan.email:465
GF_SMTP_USER=noreply@k-healthinair.eu
GF_SMTP_PASSWORD=REPLAC…WORD
GF_SMTP_FROM_ADDRESS=noreply@k-healthinair.eu
GF_SMTP_SKIP_VERIFY=false

# --- External sensor APIs (Inbiot / Qlair / Kunak) ---
INBIOT_API_URL=https://myinbiotpublicapi.com
INBIOT_API_URL_REQUEST_LIMIT=6
IND_INBIOT_PERIODICITY=10
IND_QLAIR_PERIODICITY=5
OUTDOOR_PERIODICITY=60
QLAIR_API_URL=https://api.v2.i-qlair.eu
KUNAK_API_URL=https://kunakcloud.com/openAPIv0/v1
# Base64 of "user:password" for Kunak Basic auth
KUNAK_API_BASIC_AUTH=REPLACE_ME_BASIC_AUTH
KUNAK_API_DEVICE=0423310093
