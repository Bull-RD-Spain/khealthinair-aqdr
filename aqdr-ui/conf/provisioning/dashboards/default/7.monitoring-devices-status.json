      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aqdr-platform-db"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\r\n  pilot as id_pilot,\r\n  count(sensor_id) as registered\r\nFROM\r\n  sensors\r\nWHERE\r\n  pilot IN (${pilot:singlequote})\r\nGROUP BY\r\n  pilot",
          "refId": "registered_sensors",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "aqdr-ts-db-flux"
          },
          "query": "from(bucket: \"AIR_QUALITY\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"CONTINUOUS_MONITORING_\")\r\n  |> filter(fn: (r) => r.id_pilot =~ /^${pilot:regex}$/)\r\n  |> group(columns: [\"id_pilot\",\"sensor_id\"])\r\n  |> distinct(column: \"sensor_id\")\r\n  |> group(columns: [\"id_pilot\"])\r\n  |> count(column: \"sensor_id\")\r\n  |> keep(columns: [\"id_pilot\", \"sensor_id\"])",
          "refId": "working_sensors"
        }
      ],
