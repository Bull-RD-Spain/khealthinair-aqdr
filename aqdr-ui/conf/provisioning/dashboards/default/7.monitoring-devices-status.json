        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aqdr-platform-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROW_NUMBER() OVER (ORDER BY pilot, scenario, inclusion_time, sensor_id) as n, pilot as \"Pilot\", scenario as \"Scenario\", sensor_id as \"SensorID\", to_char(\"inclusion_time\", 'DD/MM/YYYY') as \"Registered\"\r\nFROM sensors\r\nWHERE pilot IN (${pilot:singlequote})\r\nORDER BY pilot, scenario, inclusion_time, sensor_id",
          "refId": "registered",
          "sql": {
            "columns": [
              {
                "parameters": [
                  {
                    "name": "pilot",
                    "type": "functionParameter"
                  }
                ],
