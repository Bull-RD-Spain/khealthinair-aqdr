      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "aqdr-ts-db-flux"
          },
          "hide": false,
          "query": "import \"array\"\r\nimport \"join\"\r\n\r\nsensorRegistered = array.from(rows: [${sensors_stream}])\r\n  |> filter(fn: (r) => r.id_pilot =~ /^${pilot:regex}$/)\r\n  |> map(fn: (r) => ({\r\n      _value: string(v: r._value),\r\n      id_pilot: string(v: r.id_pilot)\r\n  }))\r\n\r\nsensorActives = from(bucket: \"AIR_QUALITY\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"CONTINUOUS_MONITORING_\")\r\n  |> filter(fn: (r) => r.id_pilot =~ /^${pilot:regex}$/)\r\n  |> group(columns: [\"sensor_id\"])\r\n  |> distinct(column: \"sensor_id\")\r\n  |> keep(columns: [\"_value\"])\r\n  |> map(fn: (r) => ({\r\n      _value: string(v: r._value)\r\n  }))\r\n\r\nsensorInactives = join.left(\r\n    left: sensorRegistered,\r\n    right: sensorActives,\r\n    on: (l, r) => l._value == r._value,\r\n    as: (l, r) => ({ v_left: l._value, v_right: if exists r._value then r._value else \"\"}),\r\n)\r\n  |> filter(fn: (r) => r.v_right == \"\")\r\n  |> keep(columns: [\"v_left\"])\r\n\r\nsensorInactives",
          "refId": "inactive"
        }
      ],
      "title": "Inactive monitoring sensor devices",
      "transparent": true,
      "type": "table"
    }
