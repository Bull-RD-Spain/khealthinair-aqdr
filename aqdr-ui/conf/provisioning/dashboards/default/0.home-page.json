				"content": "<style>\n @font-face { font-family: 'Quicksand'; src: url(\"public/fonts/Quicksand.woff2\") format('woff2')}\n\ttr { line-height: 14px; }\n</style>\n<div style=\"font-family: 'Quicksand', sans-serif; font-size: 0.875em;\">\n <table style=\"margin: 0 auto; background-image: linear-gradient(rgba(255,255,255,0.5),rgba(255,255,255,0.5)),url('public/img/Header_Home_si.png')\">\n <thead>\n <tr style=\"font-size: 1.2em;\">\n\t\t <td>Measure/Polutant</td>\n <th style=\"text-align: center;font-weight: bold;\">INDOOR</th>\n <th style=\"text-align: center;font-weight: bold;\">OUTDOOR</th>\n <th>Units</th>\n </tr>\n </thead>\n <tr>\n <th style=\"text-align: right; font-weight: bold;\">Temperature</th>\n <td>temperature</td>\n <td>out_temperature</td>\n <td>ºC</td>\n </tr>\n <tr>\n <th style=\"text-align: right; font-weight: bold;\">Humidity</th>\n <td>humidity</td>\n <td>out_humidity</td>\n <td>%RH</td>\n </tr>\n <tr>\n <th style=\"text-align: right; font-weight: bold;\">Particulates Matter (⌀ ≤10 µm)</th>\n <td>pm10</td>\n <td>out_pm10</td>\n <td>µg/m³</td>\n </tr>\n <tr>\n <th style=\"text-align: right; font-weight: bold;\">Particulates Matter (⌀ ≤2.5 µm)</th>\n <td>pm25</td>\n <td>out_pm25</td>\n <td>µg/m³</td>\n </tr>\n <tr>\n <th style=\"text-align: right; font-weight: bold;\">Particulates Matter (⌀ ≤1 µm)</th>\n <td>pm1</td>\n <td>-</td>\n <td>µg/m³</td>\n </tr>\n <tr>\n <th style=\"text-align: right; font-weight: bold;\">Carbon Dioxide (CO2)</th>\n <td>co2</td>\n <td>-</td>\n <td>ppm</td>\n </tr>\n <tr>\n <th style=\"text-align: right; font-weight: bold;\">Total Volatile Organic Compounds</th>\n <td>tvocs</td>\n <td>-</td>\n <td>ppb</td>\n </tr>\n <tr>\n <th style=\"text-align: right; font-weight: bold;\">Formadehydes (CH2O)</th>\n <td>formaldehyde</td>\n <td>-</td>\n <td>µg/m³</td>\n </tr>\n <tr>\n <th style=\"text-align: right; font-weight: bold;\">Carbon Monoxide (CO)</th>\n <td>-</td>\n <td>out_co*</td>\n <td>ppm</td>\n </tr>\n <tr>\n <th style=\"text